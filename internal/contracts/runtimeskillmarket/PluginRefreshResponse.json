{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AbsolutePathBuf": {
      "description": "A path that is guaranteed to be absolute and normalized (though it is not guaranteed to be canonicalized or exist on the filesystem).\n\nIMPORTANT: When deserializing an `AbsolutePathBuf`, a base path must be set using [AbsolutePathBufGuard::new]. If no base path is set, the deserialization will fail unless the path being deserialized is already absolute.",
      "type": "string"
    },
    "PluginCacheState": {
      "enum": [
        "absent",
        "valid",
        "invalid"
      ],
      "type": "string"
    },
    "PluginState": {
      "properties": {
        "cacheState": {
          "$ref": "#/definitions/PluginCacheState"
        },
        "cacheVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalogListed": {
          "type": "boolean"
        },
        "effectiveEnabled": {
          "type": "boolean"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "manifestValid": {
          "type": "boolean"
        },
        "pluginId": {
          "type": "string"
        },
        "skills": {
          "items": {
            "$ref": "#/definitions/SkillSummary"
          },
          "type": "array"
        },
        "userConfigPresent": {
          "type": "boolean"
        },
        "userEnabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "cacheState",
        "catalogListed",
        "effectiveEnabled",
        "errors",
        "manifestValid",
        "pluginId",
        "skills",
        "userConfigPresent"
      ],
      "type": "object"
    },
    "SkillInterface": {
      "properties": {
        "brandColor": {
          "type": [
            "string",
            "null"
          ]
        },
        "defaultPrompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "iconLarge": {
          "anyOf": [
            {
              "$ref": "#/definitions/AbsolutePathBuf"
            },
            {
              "type": "null"
            }
          ]
        },
        "iconSmall": {
          "anyOf": [
            {
              "$ref": "#/definitions/AbsolutePathBuf"
            },
            {
              "type": "null"
            }
          ]
        },
        "shortDescription": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SkillSummary": {
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "interface": {
          "anyOf": [
            {
              "$ref": "#/definitions/SkillInterface"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/definitions/AbsolutePathBuf"
            },
            {
              "type": "null"
            }
          ]
        },
        "shortDescription": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "description",
        "enabled",
        "name"
      ],
      "type": "object"
    }
  },
  "properties": {
    "changed": {
      "type": "boolean"
    },
    "state": {
      "$ref": "#/definitions/PluginState"
    }
  },
  "required": [
    "changed",
    "state"
  ],
  "title": "PluginRefreshResponse",
  "type": "object"
}
