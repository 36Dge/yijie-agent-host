{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yijie.ai/scheduled-tasks/draft-execution/v1",
  "title": "ScheduledDraftExecutionV1",
  "description": "Local candidate, fixed-purpose draft only. Host controls output schema/policy; no renderer paths/config/runtime identity. Missing effective policy qualification prevents Runtime/model dispatch. Accepted is not a valid/saved plan.",
  "$defs": {
    "Identity": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "Version": {
      "type": "integer",
      "const": 1
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "CreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "policy_version": {
          "type": "integer",
          "const": 1
        },
        "task_id": {
          "$ref": "#/$defs/Identity"
        },
        "workspace_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "schema_version",
        "policy_version",
        "task_id",
        "workspace_id"
      ]
    },
    "ResumeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "policy_version": {
          "type": "integer",
          "const": 1
        }
      },
      "required": [
        "schema_version",
        "policy_version"
      ]
    },
    "TurnRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "policy_version": {
          "type": "integer",
          "const": 1
        },
        "operation_id": {
          "$ref": "#/$defs/Identity"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "schema_version",
        "policy_version",
        "operation_id",
        "text"
      ]
    },
    "SessionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "policy_version": {
          "type": "integer",
          "const": 1
        },
        "purpose": {
          "type": "string",
          "const": "scheduled_plan_draft"
        },
        "task_id": {
          "$ref": "#/$defs/Identity"
        },
        "agent_session_id": {
          "$ref": "#/$defs/Identity"
        },
        "workspace_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "schema_version",
        "policy_version",
        "purpose",
        "task_id",
        "agent_session_id",
        "workspace_id"
      ]
    },
    "TurnReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "policy_version": {
          "type": "integer",
          "const": 1
        },
        "agent_session_id": {
          "$ref": "#/$defs/Identity"
        },
        "operation_id": {
          "$ref": "#/$defs/Identity"
        },
        "turn_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "schema_version",
        "policy_version",
        "agent_session_id",
        "operation_id",
        "turn_id"
      ]
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": [
            "ready",
            "storage_disabled",
            "policy_unqualified"
          ]
        }
      },
      "required": [
        "schema_version",
        "available",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": "ready"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "enum": [
                  "storage_disabled",
                  "policy_unqualified"
                ]
              }
            }
          }
        }
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "not_found",
        "request_conflict",
        "purpose_conflict",
        "storage_disabled",
        "policy_unqualified",
        "operation_unknown",
        "busy",
        "storage_unavailable",
        "unauthorized"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        }
      },
      "required": [
        "schema_version",
        "code"
      ]
    },
    "Clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "missing_fields",
        "question"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "needs_clarification"
        },
        "missing_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 6,
          "items": {
            "enum": [
              "name",
              "content",
              "frequency",
              "time",
              "time_zone",
              "target"
            ]
          }
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "name",
        "content",
        "schedule",
        "target"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "candidate"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frequency",
            "time_zone",
            "local_time"
          ],
          "properties": {
            "frequency": {
              "enum": [
                "once",
                "daily",
                "weekdays",
                "weekly"
              ]
            },
            "time_zone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "local_time": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "local_date": {
              "type": "string",
              "format": "date"
            },
            "weekdays": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "frequency": {
                    "const": "once"
                  }
                }
              },
              "then": {
                "required": [
                  "local_date"
                ],
                "properties": {
                  "local_date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "else": {
                "properties": {
                  "local_date": false
                }
              }
            },
            {
              "if": {
                "properties": {
                  "frequency": {
                    "const": "weekly"
                  }
                }
              },
              "then": {
                "required": [
                  "weekdays"
                ],
                "properties": {
                  "weekdays": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 7,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 7
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "weekdays": false
                }
              }
            }
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "dedicated_chat",
                "new_chat_each_run",
                "existing_chat"
              ]
            },
            "existing_chat_label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "existing_chat"
                  }
                }
              },
              "then": {
                "required": [
                  "existing_chat_label"
                ],
                "properties": {
                  "existing_chat_label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              },
              "else": {
                "properties": {
                  "existing_chat_label": false
                }
              }
            }
          ]
        }
      }
    },
    "Output": {
      "oneOf": [
        {
          "$ref": "#/$defs/Clarification"
        },
        {
          "$ref": "#/$defs/Candidate"
        }
      ]
    },
    "RecoveryMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "policy_version": {
          "type": "integer",
          "const": 1
        },
        "purpose": {
          "type": "string",
          "const": "scheduled_plan_draft"
        },
        "task_id": {
          "$ref": "#/$defs/Identity"
        },
        "agent_session_id": {
          "$ref": "#/$defs/Identity"
        },
        "workspace_id": {
          "$ref": "#/$defs/Identity"
        },
        "mapping_state": {
          "type": "string",
          "enum": [
            "reserved",
            "bound"
          ]
        },
        "codex_thread_id": {
          "$ref": "#/$defs/Identity"
        },
        "responding_host_instance_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "schema_version",
        "policy_version",
        "purpose",
        "task_id",
        "agent_session_id",
        "workspace_id",
        "mapping_state"
      ],
      "description": "Read-only persistent purpose and mapping. Responding instance is not the original execution generation. Omitted IDs are unknown, never non-execution evidence.",
      "allOf": [
        {
          "if": {
            "properties": {
              "mapping_state": {
                "const": "bound"
              }
            },
            "required": [
              "mapping_state"
            ]
          },
          "then": {
            "required": [
              "codex_thread_id"
            ],
            "properties": {
              "codex_thread_id": {
                "$ref": "#/$defs/Identity"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "codex_thread_id"
              ],
              "properties": {
                "codex_thread_id": {
                  "$ref": "#/$defs/Identity"
                }
              }
            }
          }
        }
      ]
    }
  }
}
