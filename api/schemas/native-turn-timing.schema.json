{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yijie.ai/native-turn-timing/v1",
  "$defs": {
    "CanonicalID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Canonical non-zero UUID; identity is checked against the managed mapping.",
      "not": {
        "enum": [
          "00000000-0000-0000-0000-000000000000"
        ]
      }
    },
    "TimeFieldState": {
      "type": "string",
      "enum": [
        "known",
        "unknown",
        "invalid"
      ]
    },
    "UnixSecondsFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/TimeFieldState"
        },
        "value": {
          "type": "integer",
          "format": "int64",
          "minimum": -8640000000000,
          "maximum": 8640000000000
        }
      },
      "description": "Runtime Unix seconds, not local receipt/schedule time. Omitted/null native field is unknown; malformed or out-of-range is invalid. Zero is valid.",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "invalid"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": false
            }
          }
        }
      ]
    },
    "DurationMsFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/TimeFieldState"
        },
        "value": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "description": "Runtime whole-turn elapsed milliseconds, including its waits. Not item/model-only time and not derived from integer seconds.",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "invalid"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": false
            }
          }
        }
      ]
    },
    "TimingSource": {
      "type": "string",
      "enum": [
        "runtime_read"
      ]
    },
    "NativeTurnTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "agent_session_id",
        "thread_id",
        "turn_id",
        "source",
        "started_at",
        "completed_at",
        "duration_ms"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "agent_session_id": {
          "$ref": "#/$defs/CanonicalID"
        },
        "thread_id": {
          "$ref": "#/$defs/CanonicalID"
        },
        "turn_id": {
          "$ref": "#/$defs/CanonicalID"
        },
        "source": {
          "$ref": "#/$defs/TimingSource"
        },
        "started_at": {
          "$ref": "#/$defs/UnixSecondsFact"
        },
        "completed_at": {
          "$ref": "#/$defs/UnixSecondsFact"
        },
        "duration_ms": {
          "$ref": "#/$defs/DurationMsFact"
        }
      }
    },
    "TimingErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unauthorized",
        "session_not_found",
        "turn_not_found",
        "native_timing_unavailable",
        "native_timing_timeout",
        "native_timing_identity_mismatch",
        "native_timing_limit_exceeded"
      ]
    },
    "TimingError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/TimingErrorCode"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    }
  }
}
