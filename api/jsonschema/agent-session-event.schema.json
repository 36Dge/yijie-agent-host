{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.yijie.ai/agent/session-event.schema.json",
  "title": "AgentSessionEvent",
  "description": "A sanitized Agent Host event. The event_type discriminator selects one payload, correlation-ID, and terminal-state variant. Sequence is monotonic only within one stream_id. A new Host process creates a new stream_id and does not replay content from an earlier process.",
  "oneOf": [
    {
      "title": "ThreadStartedEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "stream_id",
        "sequence",
        "occurred_at",
        "task_id",
        "agent_session_id",
        "codex_thread_id",
        "event_type",
        "terminal",
        "payload"
      ],
      "properties": {
        "schema_version": { "$ref": "#/definitions/schemaVersion" },
        "event_id": { "$ref": "#/definitions/eventId" },
        "stream_id": { "$ref": "#/definitions/streamId" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "occurred_at": { "$ref": "#/definitions/occurredAt" },
        "trace_id": { "$ref": "#/definitions/traceId" },
        "request_id": { "$ref": "#/definitions/requestId" },
        "tenant_id": { "$ref": "#/definitions/tenantId" },
        "user_id": { "$ref": "#/definitions/userId" },
        "task_id": { "$ref": "#/definitions/taskId" },
        "agent_session_id": { "$ref": "#/definitions/agentSessionId" },
        "codex_thread_id": { "$ref": "#/definitions/codexThreadId" },
        "event_type": { "const": "thread.started" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/threadStartedPayload" }
      }
    },
    {
      "title": "TurnStartedEvent",
      "type": "object",
