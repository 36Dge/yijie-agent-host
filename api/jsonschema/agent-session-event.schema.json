        "codex_thread_id": { "$ref": "#/definitions/codexThreadId" },
        "turn_id": { "$ref": "#/definitions/turnId" },
        "event_type": { "const": "turn.started" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/turnStartedPayload" }
      }
    },
    {
      "title": "ItemStartedEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "stream_id",
