        "item_id": { "$ref": "#/definitions/itemId" },
        "event_type": { "const": "item.completed" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/itemLifecyclePayload" }
      }
    },
    {
      "title": "TurnCompletedEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "stream_id",
        "sequence",
        "occurred_at",
        "task_id",
        "agent_session_id",
        "codex_thread_id",
        "turn_id",
        "event_type",
