        "codex_thread_id": { "$ref": "#/definitions/codexThreadId" },
        "turn_id": { "$ref": "#/definitions/turnId" },
        "event_type": { "const": "error" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/agentProblemPayload" }
      }
    },
    {
      "title": "AgentWarningEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "stream_id",
        "sequence",
        "occurred_at",
        "task_id",
        "agent_session_id",
        "codex_thread_id",
        "event_type",
        "terminal",
        "payload"
      ],
