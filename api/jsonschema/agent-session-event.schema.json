        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/agentWarningPayload" }
      }
    }
  ],
  "definitions": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "streamId": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "traceId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "userId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "format": "uuid" },
    "agentSessionId": { "type": "string", "format": "uuid" },
    "codexThreadId": { "type": "string", "format": "uuid" },
    "turnId": { "type": "string", "format": "uuid" },
    "itemId": { "type": "string", "minLength": 1 },
    "threadStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "model_provider"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "model_provider": { "type": "string", "minLength": 1 }
      }
    },
    "turnStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "in_progress" }
      }
    },
    "turnCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "interrupted", "failed"]
        },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "itemLifecyclePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_type"],
      "properties": {
        "item_type": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    },
    "agentMessageDeltaPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta"],
      "properties": {
        "delta": { "type": "string" }
      }
    },
    "agentProblemPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "will_retry"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "will_retry": { "type": "boolean" }
      }
    },
    "agentWarningPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "will_retry"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "will_retry": { "const": false }
      }
    }
  }
}
