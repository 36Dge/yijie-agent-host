{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.yijie.ai/agent/session-event-v6.schema.json",
  "title": "AgentSessionEventV6",
  "description": "Explicitly negotiated v6 Agent Host event. It preserves every v5 event family and adds the closed FEAT-137 local Command approval requested/resolved lifecycle. Ordering is monotonic only within stream_id and delivery is at least once.",
  "x-yijie-max-sse-data-utf8-bytes": 1048576,
  "x-yijie-projection-limit-policy": {
    "scope": "inherited_non_command_tool_variants",
    "mode": "reject_without_truncation",
    "reasoning_limit_result": "reasoning_finalized_unavailable",
    "managed_thread_start_result": "http_500_internal_error",
    "thread_problem_event_type": "warning",
    "problem_event_type": "error",
    "problem_code": "limit_exceeded",
    "will_retry": false,
    "terminal_status": "failed"
  },
  "x-yijie-max-reasoning-items-per-turn": 8,
  "x-yijie-max-reasoning-utf8-bytes-per-turn": 262144,
  "x-yijie-command-tool-projection-policy": {
    "scope": "command_and_tool_variants",
    "mode": "redact_then_truncate",
    "takes_precedence_within_scope": true,
    "sse_measurement": "utf8_bytes_of_compact_json_data_value",
    "redaction_before_utf8_measurement_and_truncation": true,
    "command_summary_max_utf8_bytes": 4096,
    "command_cwd_max_utf8_bytes": 1024,
    "command_cwd_separator_utf8_bytes": 1,
    "command_output_delta_max_utf8_bytes": 16384,
    "command_output_live_aggregate_max_utf8_bytes_per_item": 262144,
    "command_output_snapshot_max_utf8_bytes": 262144,
    "command_output_head_max_utf8_bytes": 131072,
    "command_output_tail_max_utf8_bytes": 131072,
    "tool_identity_part_max_utf8_bytes": 256,
    "tool_arguments_summary_max_utf8_bytes": 8192,
    "tool_progress_summary_max_utf8_bytes": 4096,
    "tool_progress_max_events_per_item": 32,
    "tool_progress_max_utf8_bytes_per_item": 65536,
    "tool_result_summary_max_utf8_bytes": 65536,
    "error_summary_max_utf8_bytes": 4096,
    "deduplicate_by": "event_id",
    "same_content_different_event_ids_are_distinct": true,
    "completed_snapshot_is_authoritative": true,
    "tool_declined_status": "reserved_without_current_runtime_producer",
    "raw_fields_are_forbidden": true
  },
  "x-yijie-command-approval-policy": {
    "scope": "exact_local_demo_fast_feat_134_feat_136_feat_137",
    "action_id": "git_repository_check",
    "workspace_scope": "current_workspace",
    "decisions": ["accept_once", "cancel_current_turn"],
    "ttl_seconds": 120,
    "max_pending_per_session": 1,
    "pending_authority": "host_memory_only",
    "runtime_accept_mapping": "accept",
    "runtime_cancel_mapping": "cancel",
    "runtime_request_identity_exposed": false,
    "runtime_compatibility_authority": "compatibility/agent-host-runtime-approval-v6-v4.json",
    "runtime_replay_behavior": "reuse_same_opaque_request_without_ttl_reset",
    "runtime_replay_conflict_behavior": "cancel_new_request_and_fail_closed_without_projection",
    "second_pending_behavior": "cancel_new_request_and_fail_closed_without_projection",
    "raw_fields_are_forbidden": [
      "runtime_request_id",
      "runtime_approval_id",
      "runtime_started_at_ms",
      "command",
      "command_actions",
      "cwd",
      "runtime_environment_id",
      "sandbox_permissions",
      "reason",
      "network_approval_context",
      "proposed_execpolicy_amendment",
      "proposed_network_policy_amendments",
      "available_decisions",
      "additional_permissions",
      "runtime_wire"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "stream_id",
    "sequence",
    "occurred_at",
    "task_id",
    "agent_session_id",
    "codex_thread_id",
    "event_type",
    "terminal",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": 6 },
    "event_id": { "type": "string", "format": "uuid" },
    "stream_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "user_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "task_id": { "type": "string", "format": "uuid" },
    "agent_session_id": { "type": "string", "format": "uuid" },
    "codex_thread_id": { "type": "string", "format": "uuid" },
    "turn_id": { "type": "string", "format": "uuid" },
    "item_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "event_type": { "type": "string" },
    "terminal": { "type": "boolean" },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/definitions/threadStartedEventV6" },
    { "$ref": "#/definitions/turnStartedEventV6" },
    { "$ref": "#/definitions/turnPlanUpdatedEventV6" },
    { "$ref": "#/definitions/itemStartedEventV6" },
    { "$ref": "#/definitions/agentMessageDeltaEventV6" },
    { "$ref": "#/definitions/commandOutputDeltaEventV6" },
    { "$ref": "#/definitions/toolProgressEventV6" },
    { "$ref": "#/definitions/approvalRequestedEventV6" },
    { "$ref": "#/definitions/approvalResolvedEventV6" },
    { "$ref": "#/definitions/reasoningTextDeltaEventV6" },
    { "$ref": "#/definitions/reasoningTextFinalizedEventV6" },
    { "$ref": "#/definitions/itemCompletedEventV6" },
    { "$ref": "#/definitions/turnCompletedEventV6" },
    { "$ref": "#/definitions/agentErrorEventV6" },
    { "$ref": "#/definitions/agentWarningEventV6" },
    { "$ref": "#/definitions/artifactStartedEvent" },
    { "$ref": "#/definitions/artifactProgressEvent" },
    { "$ref": "#/definitions/artifactCompletedEvent" },
    { "$ref": "#/definitions/artifactFailedEvent" }
  ],
  "definitions": {
    "noTurnOrItem": {
      "type": "object",
      "not": {
        "anyOf": [
          { "type": "object", "properties": { "turn_id": {} }, "required": ["turn_id"] },
          { "type": "object", "properties": { "item_id": {} }, "required": ["item_id"] }
        ]
      }
    },
    "turnWithoutItem": {
      "type": "object",
      "properties": { "turn_id": {}, "item_id": {} },
      "required": ["turn_id"],
      "not": { "type": "object", "properties": { "item_id": {} }, "required": ["item_id"] }
    },
    "threadStartedEventV6": {
      "type": "object",
      "allOf": [
        { "$ref": "#/definitions/noTurnOrItem" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "thread.started" },
            "terminal": { "const": false },
            "payload": { "$ref": "#/definitions/threadStartedPayloadV6" }
          }
        }
      ]
    },
    "turnStartedEventV6": {
      "type": "object",
      "allOf": [
        { "$ref": "#/definitions/turnWithoutItem" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "turn.started" },
            "terminal": { "const": false },
            "payload": { "$ref": "#/definitions/turnStartedPayload" }
          }
        }
      ]
    },
    "turnPlanUpdatedEventV6": {
      "type": "object",
      "allOf": [
        { "$ref": "#/definitions/turnWithoutItem" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "turn.plan.updated" },
            "terminal": { "const": false },
            "payload": { "$ref": "#/definitions/turnPlanUpdatedPayloadV6" }
          }
        }
      ]
    },
    "itemStartedEventV6": {
      "type": "object",
      "required": ["turn_id", "item_id"],
      "properties": {
        "turn_id": {},
        "item_id": {},
        "event_type": { "const": "item.started" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/itemStartedPayloadV6" }
      }
    },
    "agentMessageDeltaEventV6": {
      "type": "object",
      "required": ["turn_id", "item_id"],
      "properties": {
        "turn_id": {},
        "item_id": {},
        "event_type": { "const": "item.agent_message.delta" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/agentMessageDeltaPayload" }
      }
    },
    "commandOutputDeltaEventV6": {
      "type": "object",
      "required": ["turn_id", "item_id"],
      "properties": {
        "turn_id": {},
        "item_id": {},
        "event_type": { "const": "item.command_output.delta" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/commandOutputDeltaPayloadV6" }
      }
    },
    "toolProgressEventV6": {
      "type": "object",
      "required": ["turn_id", "item_id"],
      "properties": {
        "turn_id": {},
        "item_id": {},
        "event_type": { "const": "item.tool.progress" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/toolProgressPayloadV6" }
      }
    },
    "approvalRequestedEventV6": {
      "type": "object",
      "required": ["turn_id", "item_id"],
      "properties": {
        "request_id": false,
        "turn_id": {},
        "item_id": {},
        "event_type": { "const": "approval.requested" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/approvalRequestedPayloadV6" }
      }
    },
    "approvalResolvedEventV6": {
      "type": "object",
      "required": ["turn_id", "item_id"],
      "properties": {
        "request_id": false,
        "turn_id": {},
        "item_id": {},
        "event_type": { "const": "approval.resolved" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/approvalResolvedPayloadV6" }
      }
    },
    "reasoningTextDeltaEventV6": {
      "type": "object",
      "required": ["turn_id", "item_id"],
      "properties": {
        "turn_id": {},
        "item_id": {},
        "event_type": { "const": "item.reasoning_text.delta" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/reasoningTextDeltaPayloadV6" }
      }
    },
    "reasoningTextFinalizedEventV6": {
      "type": "object",
      "required": ["turn_id", "item_id"],
      "properties": {
        "turn_id": {},
        "item_id": {},
        "event_type": { "const": "item.reasoning_text.finalized" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/reasoningTextFinalizedPayloadV6" }
      }
    },
    "itemCompletedEventV6": {
      "type": "object",
      "required": ["turn_id", "item_id"],
      "properties": {
        "turn_id": {},
        "item_id": {},
        "event_type": { "const": "item.completed" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/itemCompletedPayloadV6" }
      }
    },
    "turnCompletedEventV6": {
      "type": "object",
      "allOf": [
        { "$ref": "#/definitions/turnWithoutItem" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "turn.completed" },
            "terminal": { "const": true },
            "payload": { "$ref": "#/definitions/turnCompletedPayloadV6" }
          }
        }
      ]
    },
    "agentErrorEventV6": {
      "type": "object",
      "allOf": [
        { "$ref": "#/definitions/turnWithoutItem" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "error" },
            "terminal": { "const": false },
            "payload": { "$ref": "#/definitions/agentProblemPayload" }
          }
        }
      ]
    },
    "agentWarningEventV6": {
      "type": "object",
      "allOf": [
        { "$ref": "#/definitions/noTurnOrItem" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "warning" },
            "terminal": { "const": false },
            "payload": { "$ref": "#/definitions/agentWarningPayloadV6" }
          }
        }
      ]
    },
    "artifactStartedEvent": {
      "type": "object",
      "required": ["turn_id"],
      "properties": {
        "turn_id": {},
        "event_type": { "const": "item.artifact.started" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/artifactStartedPayload" }
      }
    },
    "artifactProgressEvent": {
      "type": "object",
      "required": ["turn_id"],
      "properties": {
        "turn_id": {},
        "event_type": { "const": "item.artifact.progress" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/artifactProgressPayload" }
      }
    },
    "artifactCompletedEvent": {
      "type": "object",
      "required": ["turn_id"],
      "properties": {
        "turn_id": {},
        "event_type": { "const": "item.artifact.completed" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/artifactCompletedPayload" }
      }
    },
    "artifactFailedEvent": {
      "type": "object",
      "required": ["turn_id"],
      "properties": {
        "turn_id": {},
        "event_type": { "const": "item.artifact.failed" },
        "terminal": { "const": false },
        "payload": { "$ref": "#/definitions/artifactFailedPayload" }
      }
    },
    "threadStartedPayloadV6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "model_provider"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-yijie-max-utf8-bytes": 1024
        },
        "model_provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-yijie-max-utf8-bytes": 1024
        }
      }
    },
    "turnStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "in_progress" } }
    },
    "turnPlanUpdatedPayloadV6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan"],
      "properties": {
        "explanation": {
          "anyOf": [
            { "type": "string", "maxLength": 16384, "x-yijie-max-utf8-bytes": 65536 },
            { "type": "null" }
          ]
        },
        "plan": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/definitions/turnPlanStepV6" }
        }
      }
    },
    "turnPlanStepV6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "status"],
      "properties": {
        "step": {
          "type": "string",
          "maxLength": 16384,
          "x-yijie-max-utf8-bytes": 65536
        },
        "status": { "enum": ["pending", "in_progress", "completed"] }
      }
    },
    "turnCompletedPayloadV6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["completed", "interrupted", "failed"] },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "itemStartedPayloadV6": {
      "oneOf": [
        { "$ref": "#/definitions/agentMessageLifecyclePayloadV6" },
        { "$ref": "#/definitions/commandStartedPayloadV6" },
        { "$ref": "#/definitions/toolStartedPayloadV6" },
        { "$ref": "#/definitions/genericItemLifecyclePayloadV6" }
      ]
    },
    "itemCompletedPayloadV6": {
      "oneOf": [
        { "$ref": "#/definitions/agentMessageLifecyclePayloadV6" },
        { "$ref": "#/definitions/commandCompletedPayloadV6" },
        { "$ref": "#/definitions/toolCompletedPayloadV6" },
        { "$ref": "#/definitions/genericItemLifecyclePayloadV6" }
      ]
    },
    "agentMessageLifecyclePayloadV6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_type", "text", "phase"],
      "properties": {
        "item_type": { "const": "agentMessage" },
        "text": { "type": "string", "maxLength": 1048576, "x-yijie-max-utf8-bytes": 1048576 },
        "phase": {
          "anyOf": [
            { "enum": ["commentary", "final_answer"] },
            { "type": "null" }
          ]
        }
      }
    },
    "genericItemLifecyclePayloadV6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_type"],
      "properties": {
        "item_type": {
          "enum": [
            "userMessage",
            "hookPrompt",
            "reasoning",
            "collabAgentToolCall",
            "subAgentActivity",
            "webSearch",
            "imageView",
            "sleep",
            "imageGeneration",
            "enteredReviewMode",
            "exitedReviewMode",
            "contextCompaction"
          ]
        }
      }
    },
    "approvalRequestIdV6": {
      "type": "string",
      "format": "uuid",
      "description": "Host-minted opaque approval identity. It is never the Runtime request id or nullable Runtime approvalId."
    },
    "approvalDecisionV6": {
      "enum": ["accept_once", "cancel_current_turn"]
    },
    "approvalDecisionSetV6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "const": "accept_once" },
        "secondary": { "const": "cancel_current_turn" }
      }
    },
    "approvalRequestedPayloadV6": {
      "type": "object",
      "additionalProperties": false,
      "x-yijie-approval-time-window": {
        "requested_at_field": "requested_at",
        "expires_at_field": "expires_at",
        "ttl_seconds": 120
      },
      "required": [
        "item_type",
        "approval_request_id",
        "revision",
        "action_id",
        "workspace_scope",
        "decisions",
        "requested_at",
        "expires_at",
        "ttl_seconds"
      ],
      "properties": {
        "item_type": { "const": "commandExecution" },
        "approval_request_id": { "$ref": "#/definitions/approvalRequestIdV6" },
        "revision": { "const": 1 },
        "action_id": { "const": "git_repository_check" },
        "workspace_scope": { "const": "current_workspace" },
        "decisions": { "$ref": "#/definitions/approvalDecisionSetV6" },
        "requested_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "ttl_seconds": { "const": 120 }
      }
    },
    "approvalResolvedPayloadV6": {
      "type": "object",
      "additionalProperties": false,
      "x-yijie-approval-time-window": {
        "requested_at_field": "requested_at",
        "expires_at_field": "expires_at",
        "resolved_at_field": "resolved_at",
        "outcome_field": "outcome",
        "ttl_seconds": 120,
        "deadline_outcome": "expired"
      },
      "required": [
        "item_type",
        "approval_request_id",
        "revision",
        "action_id",
        "workspace_scope",
        "outcome",
        "requested_at",
        "expires_at",
        "resolved_at"
      ],
      "properties": {
        "item_type": { "const": "commandExecution" },
        "approval_request_id": { "$ref": "#/definitions/approvalRequestIdV6" },
        "revision": { "const": 2 },
        "action_id": { "const": "git_repository_check" },
        "workspace_scope": { "const": "current_workspace" },
        "outcome": {
          "enum": ["accepted_once", "cancelled_current_turn", "expired", "resolved_elsewhere"]
        },
        "decision_id": { "type": "string", "format": "uuid" },
        "decision": { "$ref": "#/definitions/approvalDecisionV6" },
        "requested_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "resolved_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "accepted_once" } }, "required": ["outcome"] },
          "then": {
            "required": ["decision_id", "decision"],
            "properties": {
              "decision_id": {},
              "decision": { "const": "accept_once" }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "cancelled_current_turn" } }, "required": ["outcome"] },
          "then": {
            "required": ["decision_id", "decision"],
            "properties": {
              "decision_id": {},
              "decision": { "const": "cancel_current_turn" }
            }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "enum": ["expired", "resolved_elsewhere"] } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "decision_id": false,
              "decision": false
            }
          }
        }
      ]
    },
    "truncationReasonV6": {
      "enum": ["utf8_byte_limit", "upstream_truncated"]
    },
    "commandSummaryV6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "truncated"],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 4096,
          "x-yijie-max-utf8-bytes": 4096
        },
        "truncated": { "type": "boolean" },
        "truncation_reason": { "$ref": "#/definitions/truncationReasonV6" }
      },
      "allOf": [
        {
          "if": { "properties": { "truncated": { "const": true } }, "required": ["truncated"] },
          "then": { "required": ["truncation_reason"], "properties": { "truncation_reason": {} } },
          "else": { "type": "object", "properties": { "truncation_reason": false } }
        }
      ]
    },
    "commandCwdV6": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "workspace_root" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "segments"],
          "properties": {
            "kind": { "const": "workspace_relative" },
            "segments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "x-yijie-max-total-utf8-bytes": 1024,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^(?!\\.{1,2}$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\..*)?$)(?!.*[ .]$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069])[^/\\\\:]+$",
                "x-yijie-max-utf8-bytes": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "redacted" } }
        }
      ]
    },
    "commandStartedPayloadV6": {
      "type": "object",
