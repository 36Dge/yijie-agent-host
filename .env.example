YIJIE_ENV=local
YIJIE_AGENT_HOST_PORT=18080

# Runtime Baseline 0 artifacts. All paths must be absolute.
YIJIE_CODEX_BINARY=/absolute/path/to/yijie-codex/.yijie/build/macos/aarch64-apple-darwin/codex
YIJIE_CODEX_MANIFEST=/absolute/path/to/yijie-codex/.yijie/build/macos/aarch64-apple-darwin/runtime-manifest.json
YIJIE_CODEX_HOME=/absolute/path/to/yijie-agent-host/.local/codex-home

# Runtime Baseline 2: MiniMax China Responses API and Host-owned state.
YIJIE_MODEL_PROVIDER=minimax
YIJIE_AGENT_HOST_HOME=/absolute/path/to/yijie-agent-host/.local/host-home
# Put the raw key in this owner-only file (chmod 600). Never commit it.
YIJIE_MINIMAX_API_KEY_FILE=/absolute/path/to/yijie-agent-host/.local/secrets/minimax-api-key

# Reliability limits.
YIJIE_CODEX_STARTUP_TIMEOUT=10s
YIJIE_CODEX_REQUEST_TIMEOUT=30s
YIJIE_CODEX_SHUTDOWN_TIMEOUT=10s
YIJIE_CODEX_MAX_MESSAGE_BYTES=16777216
YIJIE_CODEX_WRITE_QUEUE_DEPTH=64
YIJIE_CODEX_STDERR_TAIL_BYTES=65536
